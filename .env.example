FLASK_SECRET_KEY=change-me-to-a-long-random-string
PORT=8080

# Marketplace is opt-in until financial, privacy, and live OAuth gates pass.
MARKETPLACE_ENABLED=false
MARKETPLACE_MOCK_MODE=false
MARKETPLACE_ENV=development
DATABASE_URL=
TEST_DATABASE_URL=
MARKETPLACE_PUBLIC_BASE_URL=http://localhost:8080
MARKETPLACE_SESSION_TTL=86400
MARKETPLACE_INTENT_TTL=900
MARKETPLACE_OAUTH_TTL=600
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Set only after verifying a currently supported version in Meta's console.
FACEBOOK_GRAPH_VERSION=

# Portable RAG. Use none explicitly for keyword-only operation.
# Adapters: openai_compatible (any compatible endpoint), cohere, ollama, none.
EMBEDDING_PROVIDER=none
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# Optional: only set dimensions supported by your chosen model.
EMBEDDING_DIMENSIONS=
EMBEDDING_REVISION=
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
EMBEDDING_MIN_SCORE=0.30
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT=20
EMBEDDING_RETRIES=2
KNOWLEDGE_DIR=data/knowledge
# Unicode character limits, not model-specific token counts.
KNOWLEDGE_CHUNK_SIZE=1600
KNOWLEDGE_CHUNK_OVERLAP=200

# Answering is independent from embeddings. Any external agent can also use
# POST /api/knowledge/search and generate its own answer.
CHAT_PROVIDER=extractive
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_API_KEY=
# Legacy installations can keep OPENAI_API_KEY. If EMBEDDING_PROVIDER and
# CHAT_PROVIDER are unset, that key supplies the initial compatible adapters.

# Gmail SMTP (sender account)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=mohit.rohatgi2@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=mohit.rohatgi2@gmail.com

# Where waitlist notifications are delivered
MAIL_TO=mohit.rohatgi.mec10@gmail.com
